%native write
dec:
    swap 1
    push 1
    sub
    swap 1
    ret

inc:
    swap 1
    push 1
    add
    swap 1
    ret
; args: A B
; checks A > B
gt:
    swap 2
GTloop:
    ; A == B
    dup 0
    dup 2
    eq
    jnz GTno

    ; A == 0
    dup 0
    push 0
    eq
    jnz GTno

    swap 1

    ; B == 0
    dup 0
    push 0
    eq
    jnz GTyes

    call dec
    swap 1
    call dec
    jmp GTloop
GTyes:
    pop
    pop
    push 1
    swap 1
    ret
GTno:
    pop
    pop
    push 0
    swap 1
    ret

; args: A B
; checks A < B
lt:
    swap 2
LTloop:
    ; A == B
    dup 0
    dup 2
    eq
    jnz LTno

    ; A == 0
    dup 0
    push 0
    eq
    jnz LTyes

    swap 1

    ; B == 0
    dup 0
    push 0
    eq
    jnz LTno

    call dec
    swap 1
    call dec
    jmp LTloop
LTyes:
    pop
    pop
    push 1
    swap 1
    ret
LTno:
    pop
    pop
    push 0
    swap 1
    ret


allocChar:
    swap 1
    alloc 1
    dup 0
    swap 2
    write 1
    swap 1
    ret

printChar:
    swap 1
    call allocChar
    push 1
    native write
    ret

printDigit:
    swap 1
    push 48
    add
    call allocChar
    push 1
    native write
    ret



;; b
;; a

;; <a / b>
;; <a % b>
    divRem:
    swap 2
    swap 1
    dup 1
    dup 1
    div
    swap 2
    swap 1
    mod
    swap 2
    ret


; completly vibe coded cause me big dum dum
printU64:
    swap 1                  ; [n, ret_addr]

    dup 0                   ; [n, n, ret_addr]
    push 10                 ; [10, n, n, ret_addr]  -- B=10 on TOS, A=n below: lt(A,B) = n<10
    call lt                 ; [n<10, n, ret_addr]
    jnz PU64Base            ; if n < 10, print directly

    ; recursive case: n >= 10
    push 10                 ; [10, n, ret_addr]  -- b=10 on TOS, a=n below
    call divRem             ; [n%10, n/10, ret_addr]  -- quotient on TOS
    call printU64           ; recurse on quotient, leaves [n%10, ret_addr]
    call printDigit         ; print remainder
    ret

PU64Base:
    ; stack: [n, ret_addr]
    call printDigit
    ret

flush:
    push '\n'
    call printChar
    ret
